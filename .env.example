# ═══════════════════════════════════════════════════════════════
# NOD Makeup — THE single source of truth for ALL environment config.
#
# Copy this file to `.env` (repo root), fill in real values, then run:
#     node scripts/sync-env.mjs            # validate + render deploy/.env
# or, in dev on a LAN machine:
#     ./start.sh [--ip 192.168.1.18]       # merges the host into SAFE_ORIGINS
#
# Every service reads THIS file directly (backend, media-server,
# control-center) or derives client URLs in the browser (admin-panel,
# main-website). There are NO per-service .env copies. scripts/sync-env.mjs
# only validates this file and renders deploy/.env (the production compose
# bundle for the server machine).
#
# Key names are defined once in shared/src/runtime/config.ts (ENV_CONTRACT)
# and used verbatim by the backend, media-server, admin panel and storefront.
# ═══════════════════════════════════════════════════════════════

# ---- Core topology ----
PORT=5001                          # backend API port
MEDIA_PORT=5002                    # media server port
GATEWAY_URL=http://localhost:5001  # public-facing API base URL
MEDIA_BASE_URL=http://localhost:5002
ADMIN_PANEL_URL=http://localhost:3000
STORE_URL=http://localhost:3001

# ---- CORS allowlist (strict, explicit) ----
# Exact origins and/or *.subdomain wildcards. No implicit LAN trust. Used by
# backend HTTP + WebSocket CORS, media server CORS, and the Next dev-origin
# allowlist. In dev, ./start.sh merges the current host automatically.
SAFE_ORIGINS=http://localhost:3000,http://localhost:3001

# ---- Backend data + secrets ----
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/nod_makeup
REDIS_URL=redis://:PASSWORD@127.0.0.1:6379
JWT_SECRET=CHANGE_ME_64_HEX
JWT_EXPIRES_IN=15m
MEDIA_API_KEY=CHANGE_ME_64_HEX
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME_CHAT_ID

# ---- Control center operator (created by the first-run setup wizard) ----
# First-run: leave both empty and open http://127.0.0.1:4000 — the wizard
# writes the real username + bcrypt hash here for you.
CC_USERNAME=
CC_PASSWORD_HASH=

# ---- Features ----
AI_ENABLED=false
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# ---- Deployment / monitoring / backup (rendered into deploy/.env) ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_PASSWORD=CHANGE_ME_APP
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
MYSQL_EXPORTER_PASSWORD=CHANGE_ME_MYSQL_EXPORTER
BACKUP_PASSPHRASE=CHANGE_ME_BACKUP_PASSPHRASE
RCLONE_REMOTE=r2:nod-backups