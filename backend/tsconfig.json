{
  "compilerOptions": {
    /* Basic Options */
    "target": "ES2020",                     // Compile to a modern version of JavaScript
    "module": "commonjs",                  // Use the standard Node.js module system
    "rootDir": "./",                       // The root directory of your source files
    "outDir": "./dist",                    // Where to output the compiled JavaScript
    "esModuleInterop": true,               // Allows for better compatibility between CommonJS and ES Modules
    "forceConsistentCasingInFileNames": true, // Enforces case-sensitive file naming

    /* Strict Type-Checking Options */
    "strict": true,                        // Enable all strict type-checking options
    "skipLibCheck": true,                  // Skip type checking of declaration files from dependencies
    "allowJs": true,                       // Allow JS files in TypeScript project
    "resolveJsonModule": true              // Allow importing JSON modules
  },
  "include": ["**/*.ts", "**/*.js"],       // Which files to include in the compilation
  "exclude": ["node_modules", "dist"]              // Which files to exclude
}