# ===== NOD Makeup backend (API service) =====
# URLs + secrets only. Endpoint paths live in shared/api/endpoints.ts.
#
# Base URLs are the single source of truth for this stack and MUST stay in sync
# across: backend (.env), media-server (.env), main-website/.env
# (NEXT_PUBLIC_*), admin-panel/.env (REACT_APP_*).
# For production, see deploy/env/api.env.

PORT=5001

DATABASE_URL="mysql://nod:CHANGE_ME@127.0.0.1:3306/nod_makeup"

REDIS_URL="redis://:CHANGE_ME@127.0.0.1:6379"

JWT_SECRET="change-me-at-least-16-chars"
JWT_EXPIRES_IN="15m"

# ---- Base URLs (synced with media-server + frontends) ----
GATEWAY_URL="http://localhost:5001"
MEDIA_BASE_URL="http://localhost:5002"
ADMIN_PANEL_URL="http://localhost:3000"

# Shared secret for authorized server-to-server media calls (matches media-server)
MEDIA_API_KEY="change-me"

# Must list EVERY origin a browser can load the SPA from (comma separated).
# Frontends re-derive the host at runtime, so the LAN IP must appear too.
SAFE_ORIGINS="http://localhost:3000,http://localhost:3001,http://192.168.1.18:3000,http://192.168.1.18:3001"

# Telegram notifications (optional in dev)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""
