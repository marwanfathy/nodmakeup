# Control Center — local configuration (control-center/.env, gitignored)
#
# First-run: leave CC_PASSWORD_HASH empty and open the setup screen at
# http://127.0.0.1:4000 — the wizard writes CC_USERNAME + CC_PASSWORD_HASH
# here for you (bcrypt hashed) and creates the session secret in
# .runtime/secret. Everything below the hash is optional.

# Bind address/port. Localhost-only by default (the control center exposes
# start/stop + .env editing — never expose it beyond the host outside a
# private network).
CC_HOST=127.0.0.1
CC_PORT=4000

# Operator account (created by the first-run setup when the hash is empty).
CC_USERNAME=admin
CC_PASSWORD_HASH=

# Optional: how often the sampler ticks (ms) and how many points a series
# keeps. Tuning these changes the graph windows.
CC_SAMPLE_MS=5000
CC_SERIES_CAP=180

# Prometheus/Grafana bridge base (deploy/docker-compose.monitoring.yml).
# Empty = bridge tries the default local address below.
PROMETHEUS_URL=http://127.0.0.1:9090