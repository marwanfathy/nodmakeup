# Control Center — config (key CC_* lives in the ROOT .env, the single source
# of truth — this file is only a reference/example)
#
# First-run: open the setup screen at http://127.0.0.1:4000 — the wizard
# writes CC_USERNAME + CC_PASSWORD_HASH into the ROOT .env for you (bcrypt
# hashed) and creates the session secret in .runtime/secret.

# Optional: how often the sampler ticks (ms) and how many points a series
# keeps. Tuning these changes the graph windows.
CC_SAMPLE_MS=5000
CC_SERIES_CAP=180