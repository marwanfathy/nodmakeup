# ===== NOD Makeup media server =====
# URLs + secrets only. Media route paths are code constants.

# Listen port
PORT=5002

# Public URL of this media server
MEDIA_BASE_URL="http://localhost:5002"

# Comma-separated origins allowed to fetch media
# (must match backend SAFE_ORIGINS; LAN IP variant is needed when the storefront
#  / admin panel are opened from network devices)
SAFE_ORIGINS="http://localhost:3000,http://localhost:3001,http://192.168.1.18:3000,http://192.168.1.18:3001"

# Shared secret required by authorized service-to-service media calls
MEDIA_API_KEY="change-me"