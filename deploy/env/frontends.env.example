# =====================================================================
# NOD Makeup — FRONTEND build-time base URLs (storefront on Vercel,
# admin panel built and served by nginx).
#
# These are the production equivalents of the root .env URLs
# (GATEWAY_URL / MEDIA_BASE_URL) — the root .env is the single source of
# truth, and there are no per-service .env copies. For a hosted build,
# inject the same four values your deployment resolves to.
# Route paths are code constants (shared/api/endpoints.ts) — never set here.
# =====================================================================

# ---- main-website (Vercel) ----
NEXT_PUBLIC_GATEWAY_URL=https://api.nodmakeup.com
NEXT_PUBLIC_MEDIA_BASE_URL=https://media.nodmakeup.com

# ---- admin-panel (built → mounted into nginx) ----
# Note: canonical keys are REACT_APP_API_URL / REACT_APP_MEDIA_URL (the
# axiosInstance.js contract). Do NOT use REACT_APP_GATEWAY_URL names here —
# CRA silently falls back to localhost when they do not match the code.
REACT_APP_API_URL=https://api.nodmakeup.com
REACT_APP_MEDIA_URL=https://media.nodmakeup.com