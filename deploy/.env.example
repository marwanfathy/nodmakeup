# =====================================================================
# NOD Makeup — production compose secrets & base URLs  (EXAMPLE ONLY)
#
# ⚠️  Placeholders only. Copy to .env at the REPO ROOT — the ONE source of
#     truth — then run:
#         node scripts/sync-env.mjs
#     which regenerates deploy/.env, backend/.env, media-server/.env,
#     admin-panel/.env and main-website/.env from it.
#
#     Never commit real secrets. The previous committed example leaked
#     working values — those have been rotated; do not reuse them.
# =====================================================================

# ---- Data tier ----
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MYSQL_PASSWORD=CHANGE_ME_APP

# ---- App secrets (backend + worker + media) ----
JWT_SECRET=CHANGE_ME_64_HEX
JWT_EXPIRES_IN=1d
MEDIA_API_KEY=CHANGE_ME_64_HEX

# ---- Notifications ----
TELEGRAM_BOT_TOKEN=CHANGE_ME_BOT_TOKEN
TELEGRAM_ADMIN_CHAT_ID=CHANGE_ME_CHAT_ID

# ---- Local AI (Ollama) — analytics insights + daily digest ----
AI_ENABLED=false
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# ---- Monitoring ----
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA
MYSQL_EXPORTER_PASSWORD=CHANGE_ME_MYSQL_EXPORTER

# ---- Backup / DR ----
BACKUP_PASSPHRASE=CHANGE_ME_BACKUP_PASSPHRASE
RCLONE_REMOTE=r2:nod-backups

# ---- Base URLs (mirror nginx server_name + frontends.env) ----
GATEWAY_URL=https://api.nodmakeup.com
MEDIA_BASE_URL=https://media.nodmakeup.com
ADMIN_PANEL_URL=https://admin.nodmakeup.com
STORE_URL=https://nodmakeup.com
SAFE_ORIGINS=https://nodmakeup.com,https://*.nodmakeup.com