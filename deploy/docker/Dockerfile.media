# syntax=docker/dockerfile:1
# =====================================================================
#  NOD Makeup — media server (Sharp/FFmpeg image processing)
#  Build context MUST be the repo root. Plain-JS app — single stage,
#  plus a stage that compiles the shared @nod/shared runtime contract
#  (media-server/config.js requires it at ../shared).
#
#  Runtime directory classification (all recreated in-image; only the
#  permanent media tree is persisted via the media-public volume):
#    public/uploads/*   -> permanent processed media (products/assets/
#                          audio/hero/stories/videos/images)
#    public/thumbnails  -> generated thumbnails (permanent, this image writes)
#    public/temp        -> single multer staging dir (all kinds) before it is
#                          moved to uploads/*
# =====================================================================

# ---- Stage 1: build the shared contract package (@nod/shared) ----
FROM node:20-alpine AS shared
WORKDIR /wd/shared
COPY shared/package.json shared/package-lock.json ./
RUN npm ci
COPY shared/ ./
RUN npm run build

# ---- Stage 2: media server ----
FROM node:20-alpine
RUN apk add --no-cache tini openssl ffmpeg \
 && addgroup -S app && adduser -S -G app app
WORKDIR /wd/media-server
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=512"
COPY media-server/package.json media-server/package-lock.json ./
RUN npm ci --omit=dev
COPY --from=shared /wd/shared /wd/shared
COPY media-server/ ./
RUN mkdir -p public/uploads public/thumbnails public/temp \
 && chown -R app:app /wd
# Permanent uploads survive redeploys via the compose named volume media-public.
VOLUME ["/wd/media-server/public"]
USER app
EXPOSE 5002
HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=5 \
  CMD ["node","-e","fetch('http://127.0.0.1:5002/').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
ENTRYPOINT ["/sbin/tini","--"]
CMD ["node","src/server.js"]