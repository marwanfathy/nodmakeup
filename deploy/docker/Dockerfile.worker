# syntax=docker/dockerfile:1
# =====================================================================
#  NOD Makeup — background worker (BullMQ outbox + WhatsApp)
#  Build context MUST be the repo root (see Dockerfile.api).
#  Uses Debian (NOT Alpine) because Chromium needs glibc + system libs.
#  Uses the system Chromium so puppeteer downloads nothing at runtime.
#  Worker entry is dist/workers/run.js, which also starts a tiny
#  /healthz + /readyz HTTP server on PORT (default 5001) for healthchecks.
# =====================================================================

# ---- Stage 1: shared contract ----
FROM node:20-bookworm-slim AS shared
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /wd/shared
COPY shared/package.json shared/package-lock.json ./
RUN npm ci
COPY shared/ ./
RUN npm run build

# ---- Stage 2: install + compile the backend (skip Chromium download) ----
FROM node:20-bookworm-slim AS builder
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN apt-get update && apt-get install -y --no-install-recommends openssl \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /wd
COPY shared ./shared
COPY backend ./backend
RUN cd shared && npm ci && npm run build \
 && cd /wd/backend && npm ci \
 && npx prisma generate && npm run build

# ---- Stage 3: runner with Chromium deps ----
FROM node:20-bookworm-slim AS runner
ENV PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
ENV PUPPETEER_SKIP_DOWNLOAD=true
ENV NODE_ENV=production
ENV NODE_OPTIONS="--max-old-space-size=2048"
RUN apt-get update && apt-get install -y --no-install-recommends \
      tini ca-certificates fonts-liberation libasound2 libatk-bridge2.0-0 \
      libatk1.0-0 libcups2 libdbus-1-3 libdrm2 libgbm1 libglib2.0-0 \
      libnspr4 libnss3 libx11-6 libxcb1 libxcomposite1 libxdamage1 \
      libxext6 libxfixes3 libxkbcommon0 libxrandr2 chromium \
 && rm -rf /var/lib/apt/lists/* \
 && addgroup -S app && adduser -S -G app app
WORKDIR /wd
COPY --from=builder /wd/backend/package.json     /wd/backend/package-lock.json ./backend/
COPY --from=builder /wd/backend/node_modules     ./backend/node_modules
COPY --from=builder /wd/backend/dist             ./backend/dist
COPY --from=builder /wd/backend/prisma           ./backend/prisma
COPY --from=builder /wd/shared                   ./shared
RUN mkdir -p backend/.wwebjs_auth backend/.wwebjs_cache \
 && chown -R app:app /wd
USER app
WORKDIR /wd/backend
# Worker's own health server (run.ts) reports process liveness + queue depth.
HEALTHCHECK --interval=20s --timeout=5s --start-period=60s --retries=5 \
  CMD ["node","-e","fetch('http://127.0.0.1:5001/healthz').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
ENTRYPOINT ["/sbin/tini","--"]
CMD ["node","dist/workers/run.js"]